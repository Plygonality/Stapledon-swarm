{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Plygonality/Stapledon-swarm/schema/constraints.schema.json",
  "title": "Stapledon-swarm constraint file",
  "description": "Machine-checkable world-frame constraints. Markdown in constraints/ is the human restatement. This schema is what CI enforces.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "kind"],
  "properties": {
    "schema": {
      "const": "stapledon-swarm.constraints/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": ["physics", "project"]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/figure" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "rejects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reject" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "physics" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["figures", "rejects"]
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "project" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["rules"]
      }
    }
  ],
  "$defs": {
    "tag": {
      "enum": ["CANON", "INFERENCE", "OPEN"]
    },
    "owner": {
      "enum": ["stapledon-swarm", "unit-canon"]
    },
    "unit_canon_key": {
      "enum": [
        "meters_per_grid",
        "deck_height",
        "airlock_diameter",
        "human_figure.standing_height"
      ]
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "quantity", "tag", "owner", "pass", "fail"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": ["number", "string"]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "tag": { "$ref": "#/$defs/tag" },
        "owner": { "$ref": "#/$defs/owner" },
        "unit_canon_key": { "$ref": "#/$defs/unit_canon_key" },
        "pass": {
          "type": "string",
          "minLength": 1
        },
        "fail": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "owner": { "const": "unit-canon" } },
            "required": ["owner"]
          },
          "then": {
            "required": ["unit_canon_key", "value"]
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "tag"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "tag": { "$ref": "#/$defs/tag" }
      }
    },
    "reject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
